{
	"name": "@beequeue/project-template",
	"type": "module",
	"private": true,
	"version": "0.0.0",
	"author": "BeeeQueue <adam@haglund.dev>",
	"license": "MIT",
	"packageManager": "pnpm@12.4.1",
	"engines": {
		"node": "^26"
	},
	"files": [
		"dist"
	],
	"exports": {
		".": "./dist/index.mjs",
		"./package.json": "./package.json"
	},
	"lint-staged": {
		"*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,json5,yaml,yml,css,scss,md}": [
			"oxfmt --write --no-error-on-unmatched-pattern"
		]
	},
	"scripts": {
		"build": "tsdown",
		"lint": "eslint --flag unstable_native_nodejs_ts_config",
		"lint:format": "oxfmt --check",
		"test": "node --test",
		"typecheck": "tsc --noEmit",
		"lint-staged:setup": "pnpm run \"/^lint-staged:setup:/\"",
		"lint-staged:setup:1": "git config set hook.\"lint-staged\".event pre-commit",
		"lint-staged:setup:2": "git config set hook.\"lint-staged\".command \"node node_modules/lint-staged/bin/lint-staged.js\""
	},
	"devDependencies": {
		"@antfu/eslint-config": "9.5.1",
		"@tsconfig/node26": "26.0.1",
		"@tsconfig/strictest": "2.0.8",
		"@types/node": "26.6.2",
		"eslint": "10.11.0",
		"lint-staged": "17.5.1",
		"oxfmt": "0.68.0",
		"tsdown": "0.23.0",
		"typescript": "6.0.3"
	}
}
